#declaracion del funcionamiento del servomotor

angulo_actual = 90 #angulo inicial del servo
#se puede modificar

def mover_servo_lento(destino): #funcion para que el servmotor se mueva

    global angulo_actual

    paso = 1 if destino > angulo_actual else -1

    for angulo in range(
        angulo_actual,
        destino,
        paso
    ):
#formula para mover el servomotor 
        duty = int(
            26 + (128 - 26) * angulo / 180
        )

        servo.duty(duty)

        time.sleep_ms(8) # rapidez con la que se mueve el servo

    angulo_actual = destino

