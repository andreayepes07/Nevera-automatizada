#funcion de enviar mensajes a telegram
def enviar_telegram(mensaje):

    try:

        mensaje = str(mensaje) # convierte todo a texto 

        mensaje = mensaje.replace(" ", "%20")
        mensaje = mensaje.replace("\n", "%0A")
#direccion del telegram donde van a llegar los mensajes
        url = (
            "https://api.telegram.org/bot{}/sendMessage?chat_id={}&text={}"
        ).format(
            BOT_TOKEN,
            CHAT_ID,
            mensaje
        )
#envia los mensajes de lo que pasa en el codigo al telegram
        respuesta = urequests.get(url)

        print("Telegram:", respuesta.text)

        respuesta.close() #libera la memoria de las listas que ya se usaron

    except Exception as e:

        print("Error Telegram:", e)

# funcion para que telegram lea los comandos que se le mandan
def leer_telegram():

    global ULTIMO_UPDATE
    
    try:
#direccion del telegram donde van a llegar los mensajes
        url = "https://api.telegram.org/bot{}/getUpdates?offset={}".format(
            BOT_TOKEN,
            ULTIMO_UPDATE + 1
        )

        r = urequests.get(url)
#convierte la respuesta a un formato json osea que podamos leer la informacion
        datos = r.json()

        r.close()

        if "result" not in datos:
            return
#recorre la informacion que nosotros le enviamos
        for mensaje in datos["result"]:

            ULTIMO_UPDATE = mensaje["update_id"]

            # valida que si sea un comando
            if "message" not in mensaje:
                continue

            if "text" not in mensaje["message"]:
                continue
# obtiene el comando que le mandamos 
            texto = mensaje["message"]["text"].strip()
#confirma que si se recibe un comando
            print("Comando recibido:", texto)

 # comando a usar con telegram
            if texto == "/estado":

                enviar_telegram(
                    "TEMP: " + str(round(temperatura,1)) +
                    "\nHUM: " + str(round(humedad,1)) +
                    "\nLUZ: " + str(luz) +
                    "\nESTADO: " + estado
                )
#si se escribio temp que se devuelva temperatura
            elif texto == "/temp":

                enviar_telegram(
                    "TEMPERATURA: " +
                    str(round(temperatura,1)) + " C"
                )
#si se escribio humedad que se devuelva el valor de la humedad
            elif texto == "/humedad":

                enviar_telegram(
                    "HUMEDAD: " +
                    str(round(humedad,1)) + " %"
                )
#si se escribio luz devuelve el valor de lectura de la luz que se detecta
            elif texto == "/luz":

                enviar_telegram(
                    "LUZ: " + str(luz)
                )
#si se envio general que responda con todas las variables actuales
            elif texto == "/general":

                enviar_telegram(
                    "ESTADO: " + estado
                )

    except Exception as e:

        print("Error Telegram comandos:", e)
